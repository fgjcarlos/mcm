[
  {
    "id": "mcm-nodered-tab",
    "type": "tab",
    "label": "MCM Mosquitto Examples",
    "disabled": false,
    "info": "Example flows for publishing telemetry and verifying ACL behavior against an MCM-managed Mosquitto broker."
  },
  {
    "id": "mcm-publish-inject",
    "type": "inject",
    "z": "mcm-nodered-tab",
    "name": "Every 10s",
    "props": [],
    "repeat": "10",
    "crontab": "",
    "once": true,
    "onceDelay": "1",
    "topic": "",
    "x": 130,
    "y": 100,
    "wires": [["mcm-publish-function"]]
  },
  {
    "id": "mcm-publish-function",
    "type": "function",
    "z": "mcm-nodered-tab",
    "name": "Build telemetry payload",
    "func": "msg.payload = {\n  device_id: \"sensor-01\",\n  temperature: +(20 + Math.random() * 15).toFixed(2),\n  humidity: +(40 + Math.random() * 40).toFixed(1),\n  pressure: +(1010 + Math.random() * 20).toFixed(1),\n  timestamp: new Date().toISOString()\n};\nmsg.topic = \"plant/area-1/sensor-01/telemetry\";\nreturn msg;",
    "outputs": 1,
    "timeout": "",
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
    "wires": [["mcm-mqtt-out"]]
  },
  {
    "id": "mcm-mqtt-out",
    "type": "mqtt out",
    "z": "mcm-nodered-tab",
    "name": "Publish to Mosquitto",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "application/json",
    "userProperties": "",
    "correl": "",
    "expiry": "",
    "broker": "mcm-broker",
    "x": 580,
    "y": 100,
    "wires": []
  },
  {
    "id": "mcm-mqtt-in",
    "type": "mqtt in",
    "z": "mcm-nodered-tab",
    "name": "Subscribe plant/#",
    "topic": "plant/#",
    "qos": "1",
    "datatype": "json",
    "broker": "mcm-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 140,
    "y": 240,
    "wires": [["mcm-subscribe-debug"]]
  },
  {
    "id": "mcm-subscribe-debug",
    "type": "debug",
    "z": "mcm-nodered-tab",
    "name": "Log received message",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.device_id",
    "statusType": "msg",
    "x": 370,
    "y": 240,
    "wires": []
  },
  {
    "id": "mcm-acl-inject",
    "type": "inject",
    "z": "mcm-nodered-tab",
    "name": "Test ACL denial",
    "props": [
      { "p": "payload", "v": "should be denied", "vt": "str" },
      { "p": "topic", "v": "$SYS/broker/version", "vt": "str" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": "",
    "x": 140,
    "y": 380,
    "wires": [["mcm-acl-mqtt-out"]]
  },
  {
    "id": "mcm-acl-mqtt-out",
    "type": "mqtt out",
    "z": "mcm-nodered-tab",
    "name": "Publish to $SYS (denied)",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProperties": "",
    "correl": "",
    "expiry": "",
    "broker": "mcm-broker",
    "x": 400,
    "y": 380,
    "wires": []
  },
  {
    "id": "mcm-broker",
    "type": "mqtt-broker",
    "name": "MCM Mosquitto",
    "broker": "localhost",
    "port": "1883",
    "clientid": "nodered-mcm-example",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "closeTopic": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "sessionExpiry": ""
  }
]
