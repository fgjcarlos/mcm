---
import Layout from "../layouts/Layout.astro";
import FeatureSection from "../components/FeatureSection.astro";

const repoURL = "https://github.com/fgjcarlos/mcm";

const backendFeatures = [
  { title: "MQTT users and basic ACLs", body: "Create, disable and rotate MQTT credentials. Edit user/topic permissions, then review and apply their password and ACL files." },
  { title: "Deployment review and history", body: "Preview password/ACL differences and track apply attempts. Verified activation and recovery after partial failures are still being improved." },
  { title: "Operator access and audit", body: "Separate dashboard accounts, role-based access, two-factor authentication, and administrative audit and security events." },
];

const frontendFeatures = [
  { title: "Observed MQTT traffic", body: "Inspect topic names and bounded payload previews received by MCM. This is observed traffic, not a complete client inventory." },
  { title: "Connection events", body: "Follow MCM connection transitions and operational events. Full Mosquitto log ingestion and broker metrics are planned." },
  { title: "Optional message diagnostics", body: "Sparkplug B inspection and JSON Schema results help inspect messages. They do not configure the broker or enforce payload rejection." },
];

const opsFeatures = [
  { title: "One managed broker", body: "A Go application image with its embedded React UI, SQLite management state, and a separate Mosquitto broker container." },
  { title: "Administration API", body: "REST and authenticated WebSocket interfaces accompany the dashboard. Broker configuration editing is a planned extension." },
  { title: "Development and verification", body: "Docker Compose and Taskfile support local development. Production activation and complete backup/restore remain tracked work." },
];

const plannedFeatures = [
  { title: "Import and edit configuration", body: "A version-aware editor for mosquitto.conf and included files, preserving existing settings, comments and advanced directives." },
  { title: "Listeners, TLS and bridges", body: "Guided configuration of MQTT and WebSocket listeners, broker certificates, authentication and connections between brokers." },
  { title: "General settings and plugins", body: "Persistence, limits, sessions, logging and supported plugins, including Dynamic Security, with explicit version compatibility." },
  { title: "Verified changes and recovery", body: "Review an immutable revision, see whether it needs reload or restart, verify activation and recover the previous configuration." },
];

const quickStart = [
  {
    label: "Clone and build",
    code: "git clone https://github.com/fgjcarlos/mcm.git && cd mcm && task build",
  },
  {
    label: "Start the stack",
    code: "task up",
  },
  {
    label: "Capture the bootstrap admin",
    code: "task logs    # look for 'bootstrap admin created' — username + password",
  },
  {
    label: "Open the dashboard",
    code: "http://localhost:8080",
  },
];

const stack = [
  "Go 1.25",
  "net/http + slog",
  "SQLite (pure Go)",
  "paho MQTT",
  "Prometheus",
  "OpenAPI 3.1",
  "React 19 + Vite 8",
  "Tailwind 4",
];
---

<Layout
  title="MCM — Mosquitto Control Manager"
  description="MCM is building a graphical configuration manager for Eclipse Mosquitto. Explore current user and ACL management, the configuration roadmap, and alpha limitations."
>
  <main class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-24">
    <header class="flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-cyan-300/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-cyan-100">Alpha</span>
        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-slate-300">Apache 2.0</span>
        <a
          class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-slate-300 transition hover:border-white/30 hover:text-white"
          href={`${repoURL}/actions/workflows/ci.yml`}
          rel="noopener noreferrer"
          target="_blank"
        >
          Image CI
        </a>
      </div>

      <div class="max-w-3xl space-y-5">
        <p class="text-sm font-semibold uppercase tracking-[0.4em] text-cyan-300">Mosquitto Control Manager</p>
        <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-6xl">
          Mosquitto configuration, from your browser.
        </h1>
        <p class="text-lg leading-relaxed text-slate-300 sm:text-xl">
          MCM aims to let you import, edit, validate, apply and recover the configuration of a Mosquitto
          broker from a web interface. Mosquitto remains your MQTT broker.
        </p>
        <p class="text-base leading-relaxed text-cyan-100/90">
          Alpha today: MQTT users, basic ACLs and observed traffic. Full broker configuration editing is still in development.
        </p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          class="inline-flex items-center gap-2 rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-950 transition hover:bg-cyan-300"
          href={repoURL}
          rel="noopener noreferrer"
          target="_blank"
        >
          View on GitHub
          <span aria-hidden="true">→</span>
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-100 transition hover:border-white/40 hover:text-white"
          href={`${repoURL}/blob/main/docs/openapi.yaml`}
          rel="noopener noreferrer"
          target="_blank"
        >
          OpenAPI spec
        </a>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-100 transition hover:border-white/40 hover:text-white"
          href={`${repoURL}/blob/main/ROADMAP.md`}
          rel="noopener noreferrer"
          target="_blank"
        >
          Roadmap
        </a>
      </div>
    </header>

    <section class="mt-20 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
      <article class="rounded-3xl border border-white/10 bg-slate-950/55 p-8 backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">What MCM is</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white">One broker. A clear administration workflow.</h2>
        <p class="mt-5 leading-relaxed text-slate-300">
          The goal is to configure one Mosquitto instance without hand-editing files during routine administration.
          Guided forms and an advanced editor will cover explicitly supported broker versions, while preserving
          existing configuration and showing the effect of every change.
        </p>
        <p class="mt-3 leading-relaxed text-slate-300">
          Today, MCM manages MQTT users and basic ACLs through generated files. It also provides operator
          access control, audit views and traffic inspection. Editing listeners, certificates, bridges and
          general broker settings remains planned work.
        </p>
      </article>
      <article class="rounded-3xl border border-cyan-300/20 bg-cyan-400/10 p-8 backdrop-blur">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-100">Stack</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {stack.map((item) => (
            <li class="rounded-full border border-white/10 bg-slate-950/40 px-3 py-1 font-mono text-xs text-cyan-100">
              {item}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm leading-relaxed text-cyan-50/80">
          MCM packages its backend and dashboard in one application image. Mosquitto runs separately in the
          Compose stack. SQLite is the only implemented management database.
        </p>
      </article>
    </section>

    <section class="mt-20 space-y-10">
      <div class="flex flex-col gap-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">What works today</p>
        <h2 class="text-3xl font-semibold tracking-tight text-white">Available now, with a defined scope.</h2>
        <p class="max-w-2xl text-slate-300">
          The configuration-manager MVP is not complete. These capabilities exist today; the roadmap tracks
          the remaining configuration coverage, activation checks and recovery work.
        </p>
      </div>

      <div class="space-y-8">
        <FeatureSection label="Administration" items={backendFeatures} />
        <FeatureSection label="Diagnostics" items={frontendFeatures} />
        <FeatureSection label="Operations" items={opsFeatures} />
      </div>
    </section>

    <section class="mt-20 space-y-8" id="roadmap">
      <div class="max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">Planned configuration workflow</p>
        <h2 class="text-3xl font-semibold tracking-tight text-white">Import. Review. Apply. Recover.</h2>
        <p class="leading-relaxed text-slate-300">These features are planned, not available controls in the current alpha. Compatibility will be defined and tested for specific Mosquitto versions.</p>
      </div>
      <FeatureSection label="Next capabilities" items={plannedFeatures} />
      <div class="rounded-3xl border border-amber-300/25 bg-amber-400/10 p-6 sm:p-8">
        <h3 class="text-xl font-semibold text-amber-100">Before relying on production changes</h3>
        <p class="mt-3 leading-relaxed text-slate-300">Activation verification, recovery after partial writes and production file permissions need work. The existing volume backup and restore recipes also have known limitations. Review the deployment guide before enabling writes on an existing broker.</p>
        <div class="mt-5 flex flex-wrap gap-5 text-sm font-semibold text-cyan-100">
          <a class="underline underline-offset-4" href={`${repoURL}/issues/308`}>Implementation tracker</a>
          <a class="underline underline-offset-4" href={`${repoURL}/blob/main/docs/product-scope.md`}>Scope and acceptance criteria</a>
          <a class="underline underline-offset-4" href={`${repoURL}/blob/main/docs/production.md#current-limitations`}>Production limitations</a>
        </div>
      </div>
      <p class="max-w-3xl text-sm leading-relaxed text-slate-400">Sparkplug and JSON Schema remain optional diagnostics. Multi-broker administration, fleets, SSO and high availability are deferred while the one-broker configuration workflow is completed.</p>
    </section>

    <section class="mt-20 rounded-3xl border border-white/10 bg-slate-950/55 p-8 backdrop-blur">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">Quick start</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white">Try the current alpha locally.</h2>
      <p class="mt-4 text-sm leading-relaxed text-slate-300">Requires Git, Docker with Compose, and Task. This starts the development stack; it is not a production setup.</p>
      <ol class="mt-8 space-y-4">
        {quickStart.map((step, idx) => (
          <li class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-cyan-300/40 bg-cyan-400/10 font-mono text-sm font-semibold text-cyan-100">
              {String(idx + 1).padStart(2, "0")}
            </span>
            <div class="flex w-full flex-col gap-1">
              <span class="text-sm uppercase tracking-[0.22em] text-slate-400">{step.label}</span>
              <code class="block w-full overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 font-mono text-sm text-cyan-100">
                {step.code}
              </code>
            </div>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-slate-400">
        For deployment requirements, TLS and known backup/recovery limitations, read
        <a class="underline-offset-4 hover:underline" href={`${repoURL}/blob/main/docs/production.md`}>docs/production.md</a>.
      </p>
    </section>

    <footer class="mt-20 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-400 sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} MCM contributors · Apache 2.0</p>
      <div class="flex flex-wrap gap-4">
        <a class="hover:text-white" href={repoURL} rel="noopener noreferrer" target="_blank">GitHub</a>
        <a class="hover:text-white" href={`${repoURL}/issues`} rel="noopener noreferrer" target="_blank">Issues</a>
        <a class="hover:text-white" href={`${repoURL}/blob/main/docs/openapi.yaml`} rel="noopener noreferrer" target="_blank">API spec</a>
        <a class="hover:text-white" href={`${repoURL}/blob/main/SECURITY.md`} rel="noopener noreferrer" target="_blank">Security</a>
      </div>
    </footer>
  </main>
</Layout>