---
import Layout from "../layouts/Layout.astro";
import FeatureSection from "../components/FeatureSection.astro";
import brokerOverview from "../assets/hmi-overview.webp";
import mqttUsers from "../assets/hmi-users.webp";

const repoURL = "https://github.com/fgjcarlos/mcm";

const configurationFeatures = [
  { title: "Shape the broker", body: "Manage MQTT and WebSocket listeners, broker TLS certificates, general settings, bridges, and plugins—including Dynamic Security. The advanced root mosquitto.conf editor supports import, review, apply, and revision recovery." },
  { title: "Manage access", body: "Create and manage MQTT users and basic topic permissions. Native ACL coverage is partial." },
  { title: "Review and apply", body: "Review configuration changes before applying them. Applying changes requires recent MFA; recovery and verification still have known limits." },
];

const observeFeatures = [
  { title: "See observed traffic", body: "Inspect messages MCM sees arrive and topic activity. This is not a complete client inventory." },
  { title: "Inspect messages", body: "Optional Sparkplug B and JSON Schema diagnostics help inspect observed messages; they do not enforce payload rejection in Mosquitto." },
  { title: "Administer MCM", body: "Manage operator accounts, roles, MFA, audit events, and connection events separately from MQTT users and broker permissions." },
];

const quickStart = [
  { label: "Clone and build", code: "git clone https://github.com/fgjcarlos/mcm.git && cd mcm && task build" },
  { label: "Start the development stack", code: "task up" },
  { label: "Find the bootstrap credentials", code: "task logs    # first-boot admin credentials are printed here when generated" },
  { label: "Open MCM", code: "http://localhost:8080" },
];

const stack = ["Go 1.25", "SQLite", "Mosquitto", "React 19 + Vite 8", "REST + WebSocket API"];
---

<Layout
  title="MCM — Mosquitto Control Manager"
  description="MCM is a self-hosted administration interface for an existing Mosquitto broker. See what is available in the alpha and try it locally."
>
  <main class="mx-auto w-full max-w-6xl px-6 py-16 sm:py-24">
    <header class="flex flex-col gap-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="rounded-full border border-cyan-300/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.25em] text-cyan-100">Alpha</span>
        <span class="rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs font-medium text-slate-300">Apache 2.0</span>
        <a class="text-xs font-medium text-slate-400 underline-offset-4 transition hover:text-white hover:underline" href={`${repoURL}/actions/workflows/ci.yml`} rel="noopener noreferrer" target="_blank">Image CI workflow</a>
      </div>

      <div class="max-w-3xl space-y-5">
        <p class="text-sm font-semibold uppercase tracking-[0.4em] text-cyan-300">Mosquitto Control Manager</p>
        <h1 class="text-4xl font-semibold tracking-tight text-white sm:text-6xl">Administer an existing Mosquitto broker from the web.</h1>
        <p class="text-lg leading-relaxed text-slate-300 sm:text-xl">
          MCM is a self-hosted administration interface for an existing Mosquitto broker. Mosquitto remains responsible for MQTT; MCM provides the browser UI and API for managing one broker.
        </p>
        <p class="text-base leading-relaxed text-cyan-100/90">Alpha: useful configuration controls are available today, while the graphical configuration MVP is still being completed.</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a class="inline-flex min-h-12 items-center gap-2 rounded-full bg-cyan-400 px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-950 transition hover:bg-cyan-300 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200" href="#quick-start">
          Try locally <span aria-hidden="true">↓</span>
        </a>
        <a class="inline-flex min-h-12 items-center rounded-full border border-white/15 bg-white/[0.04] px-5 py-3 text-sm font-semibold uppercase tracking-[0.18em] text-slate-100 transition hover:border-white/40 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cyan-200" href={repoURL} rel="noopener noreferrer" target="_blank">GitHub</a>
      </div>
    </header>

    <section class="mt-20 space-y-8" aria-labelledby="availability-title">
      <div class="max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">Availability</p>
        <h2 id="availability-title" class="text-3xl font-semibold tracking-tight text-white">What you can change today—and what remains.</h2>
        <p class="leading-relaxed text-slate-300">The current alpha manages one Mosquitto broker. The available controls are real; coverage and production readiness are not complete.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-3">
        <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
          <h3 class="text-lg font-semibold text-white">Available controls</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">MQTT users and basic ACLs (rules that control which topics each user can access); listeners and broker TLS material; general broker settings; bridges; plugins, including Dynamic Security; and the advanced root <code class="font-mono text-cyan-100">mosquitto.conf</code> editor. Applying changes requires recent MFA.</p>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
          <h3 class="text-lg font-semibold text-white">Remaining MVP work</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">Broader native ACL coverage, complete backup and restore (<a class="underline decoration-white/30 underline-offset-4 hover:text-white" href={`${repoURL}/issues/295`}>#295</a>), and an explicit Mosquitto version support matrix remain unfinished. Some configuration directives and included files are not editable through guided controls.</p>
        </article>
        <article class="rounded-3xl border border-white/10 bg-white/[0.04] p-6">
          <h3 class="text-lg font-semibold text-white">Known limitations</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">SQLite is the only implemented management database. Observed traffic is not a full client inventory; diagnostics inspect but do not enforce. Fleets, multi-broker, SSO, high availability, and PostgreSQL are deferred.</p>
        </article>
      </div>
    </section>

    <section class="mt-20 space-y-8" aria-labelledby="evidence-title">
      <div class="max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">Product evidence</p>
        <h2 id="evidence-title" class="text-3xl font-semibold tracking-tight text-white">A view into the running product.</h2>
        <p class="leading-relaxed text-slate-300">These captures show real MCM screens: observed broker activity and MQTT user administration.</p>
      </div>
      <div class="grid gap-6 lg:grid-cols-2">
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950/55">
          <img class="block h-auto w-full" src={brokerOverview.src} width={brokerOverview.width} height={brokerOverview.height} alt="MCM broker overview showing connection status, observed message rate and top topics; client IDs are unavailable in this observed traffic view." loading="lazy" />
          <figcaption class="border-t border-white/10 px-5 py-4 text-sm leading-relaxed text-slate-300">Broker overview: connection status, observed message rate, and top topics. Client IDs are unavailable in this view; observed messages are not a complete client inventory.</figcaption>
        </figure>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-slate-950/55">
          <img class="block h-auto w-full" src={mqttUsers.src} width={mqttUsers.width} height={mqttUsers.height} alt="MCM MQTT user directory showing user status and controls to disable an account or reset its password." loading="lazy" />
          <figcaption class="border-t border-white/10 px-5 py-4 text-sm leading-relaxed text-slate-300">MQTT user directory: view user status, disable an account, or reset its password.</figcaption>
        </figure>
      </div>
    </section>

    <section class="mt-20 space-y-10" aria-labelledby="controls-title">
      <div class="max-w-3xl space-y-3">
        <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">What MCM does</p>
        <h2 id="controls-title" class="text-3xl font-semibold tracking-tight text-white">A broker workflow, organized around operator tasks.</h2>
      </div>
      <div class="space-y-8">
        <FeatureSection label="Configure and apply" items={configurationFeatures} />
        <FeatureSection label="Observe and administer" items={observeFeatures} />
      </div>
    </section>

    <section class="mt-20 rounded-3xl border border-amber-300/25 bg-amber-400/10 p-6 sm:p-8" aria-labelledby="production-title">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-amber-200">Caution</p>
      <h2 id="production-title" class="mt-3 text-2xl font-semibold text-amber-100">Alpha software; review production limits before applying changes.</h2>
      <p class="mt-3 leading-relaxed text-slate-300">Activation verification and recovery have known gaps, and backup/restore is incomplete. Review deployment requirements before enabling writes on an existing broker.</p>
      <div class="mt-5 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold text-cyan-100">
        <a class="underline underline-offset-4" href={`${repoURL}/issues/308`}>Configuration MVP tracker</a>
        <a class="underline underline-offset-4" href={`${repoURL}/blob/main/docs/product-scope.md`}>Scope and acceptance criteria</a>
        <a class="underline underline-offset-4" href={`${repoURL}/blob/main/docs/production.md#current-limitations`}>Production limitations</a>
      </div>
    </section>

    <section id="quick-start" class="mt-20 scroll-mt-8 rounded-3xl border border-white/10 bg-slate-950/55 p-8 backdrop-blur" aria-labelledby="quick-start-title">
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-cyan-300">Quick start</p>
      <h2 id="quick-start-title" class="mt-3 text-3xl font-semibold tracking-tight text-white">Run the alpha locally.</h2>
      <p class="mt-4 text-sm leading-relaxed text-slate-300">Requires Git, Docker with Compose, and Task. These commands start the development stack, not a production deployment.</p>
      <ol class="mt-8 space-y-4">
        {quickStart.map((step, idx) => (
          <li class="flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-6">
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-cyan-300/40 bg-cyan-400/10 font-mono text-sm font-semibold text-cyan-100">{String(idx + 1).padStart(2, "0")}</span>
            <div class="flex w-full min-w-0 flex-col gap-1">
              <span class="text-sm uppercase tracking-[0.22em] text-slate-400">{step.label}</span>
              <code class="block w-full overflow-x-auto rounded-2xl border border-white/10 bg-slate-950/70 px-4 py-3 font-mono text-sm text-cyan-100">{step.code}</code>
            </div>
          </li>
        ))}
      </ol>
      <div class="mt-8 rounded-2xl border border-cyan-300/20 bg-cyan-400/5 p-5">
        <h3 class="font-semibold text-white">Success checkpoint</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-300">You should now see the MCM sign-in page at <code class="font-mono text-cyan-100">localhost:8080</code>. Sign in as <code class="font-mono text-cyan-100">admin</code> with the bootstrap password from the first-start logs.</p>
      </div>
      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <h3 class="font-semibold text-white">No bootstrap credentials in the logs?</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">There is no default password. If no generated credentials appear, check whether <code class="font-mono text-cyan-100">MCM_BOOTSTRAP_ADMIN_USERNAME</code> and <code class="font-mono text-cyan-100">MCM_BOOTSTRAP_ADMIN_PASSWORD</code> were set before first start, then use those values. Do not guess or reuse a broker password.</p>
        </div>
        <div>
          <h3 class="font-semibold text-white">Dashboard unreachable?</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-300">Run <code class="font-mono text-cyan-100">task ps</code> to check the services, then <code class="font-mono text-cyan-100">task logs</code> for startup errors. Confirm port 8080 is available and run <code class="font-mono text-cyan-100">task ready</code> to check readiness.</p>
        </div>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-slate-400">Stop the stack with <code class="font-mono text-cyan-100">task down</code>. For deployment requirements, broker TLS, and recovery limits, read <a class="underline-offset-4 hover:underline" href={`${repoURL}/blob/main/docs/production.md`}>docs/production.md</a>.</p>
    </section>

    <details class="mt-12 rounded-3xl border border-white/10 bg-white/[0.03] p-6">
      <summary class="cursor-pointer font-semibold text-slate-200">Technical stack</summary>
      <ul class="mt-4 flex flex-wrap gap-2">
        {stack.map((item) => <li class="rounded-full border border-white/10 bg-slate-950/40 px-3 py-1 font-mono text-xs text-cyan-100">{item}</li>)}
      </ul>
      <p class="mt-4 text-sm leading-relaxed text-slate-400">MCM's application includes the dashboard and management API; Mosquitto runs separately. SQLite is the only implemented management database.</p>
    </details>

    <footer class="mt-20 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-8 text-sm text-slate-400 sm:flex-row sm:items-center">
      <p>© {new Date().getFullYear()} MCM contributors · Apache 2.0</p>
      <nav aria-label="Project resources" class="flex flex-wrap gap-x-5 gap-y-3">
        <a class="hover:text-white" href={repoURL} rel="noopener noreferrer" target="_blank">GitHub</a>
        <a class="hover:text-white" href={`${repoURL}/issues`} rel="noopener noreferrer" target="_blank">Issues</a>
        <a class="hover:text-white" href={`${repoURL}/blob/main/docs/openapi.yaml`} rel="noopener noreferrer" target="_blank">OpenAPI spec</a>
        <a class="hover:text-white" href={`${repoURL}/blob/main/SECURITY.md`} rel="noopener noreferrer" target="_blank">Security</a>
      </nav>
    </footer>
  </main>
</Layout>
