---
// One modal viewer for every EvidenceFigure on the page: the capture at its
// natural size in a scroll box (pan by scrolling, dragging on touch, or the
// arrow keys once focused). showModal() makes the rest of the page inert;
// global.css locks the page scroll while it is open.
---

<dialog
  data-capture-viewer
  aria-labelledby="capture-viewer-title"
  class="fixed inset-0 m-0 size-full max-h-none max-w-none border-0 bg-frame p-0 text-enamel"
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-track px-4 py-3 sm:px-6">
      <div class="min-w-0">
        <h2 id="capture-viewer-title" class="font-display text-lg font-semibold uppercase leading-tight tracking-[0.08em] text-enamel-bright">Full-size capture</h2>
        <p class="text-sm text-enamel-muted">Scroll or drag to move around the image.</p>
      </div>
      <button
        type="button"
        data-capture-close
        class="inline-flex min-h-11 shrink-0 items-center gap-2 rounded-[2px] border border-track-strong bg-frame px-4 font-mono text-xs uppercase tracking-[0.12em] text-enamel transition-colors duration-150 hover:border-track-bright hover:text-enamel-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M2 2l8 8M10 2l-8 8" /></svg>
        Close
      </button>
    </div>
    <div data-capture-scroll role="region" aria-label="Capture at full size" tabindex="0" class="min-h-0 flex-1 overflow-auto overscroll-contain">
      {/* capture-viewer.ts adds the <img>, so no empty image ships without JS. */}
      <div data-capture-frame class="flex min-h-full w-max min-w-full items-center justify-center p-4 sm:p-6 [&>img]:block [&>img]:max-w-none"></div>
    </div>
  </div>
</dialog>

<script>
  import { bootCaptureViewer } from "../scripts/capture-viewer";
  bootCaptureViewer();
</script>
