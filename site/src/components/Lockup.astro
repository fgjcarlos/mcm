---
import Mark from "../assets/brand/mark.svg";

interface Props {
  href?: string;
}

const { href } = Astro.props;
const Tag = href ? "a" : "p";
---

<Tag href={href} class="inline-flex items-center gap-3 text-enamel-bright">
  <Mark width={28} height={28} aria-hidden="true" class="shrink-0" />
  <span class="font-display text-lg font-semibold uppercase leading-none tracking-[0.1em]">Mosquitto Control Manager</span>
</Tag>
