---
interface Props {
  n: number;
  label: string;
  code: string;
}

const { n, label, code } = Astro.props;
// Callers may pass a falsy expression; only render the slot when it has markup.
const extra = Astro.slots.has("default") ? (await Astro.slots.render("default")).trim() : "";
---

<li data-command-step class="group grid grid-cols-[2.75rem_minmax(0,1fr)] gap-x-4 sm:grid-cols-[3rem_minmax(0,1fr)] sm:gap-x-6">
  <div class="flex flex-col items-center">
    <span class="flex size-11 items-center justify-center rounded-[2px] bg-enamel font-display text-xl font-bold leading-none text-frame shadow-[inset_0_1px_0_rgb(255_255_255/0.4),inset_0_-2px_0_rgb(0_0_0/0.22)] sm:size-12">{String(n).padStart(2, "0")}</span>
    <span aria-hidden="true" class="mt-3 w-px flex-1 bg-track-strong group-last:hidden"></span>
  </div>
  <div class="min-w-0 pb-12 group-last:pb-0">
    <div class="flex items-start justify-between gap-x-4">
      <p class="pt-2.5 font-display text-lg font-semibold uppercase leading-tight tracking-[0.08em] text-pretty text-enamel">{label}</p>
      <button
        type="button"
        data-copy
        hidden
        class="mt-1.5 inline-flex min-h-9 min-w-9 shrink-0 items-center justify-center gap-2 rounded-[2px] border border-track-strong px-3 font-mono text-xs uppercase tracking-[0.12em] text-enamel transition-colors duration-150 hover:border-track-bright hover:bg-frame-raised hover:text-enamel-bright"
      >
        <svg aria-hidden="true" viewBox="0 0 12 12" class="size-3" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h7v7H4zM8 4V1H1v7h3" /></svg>
        <span class="max-sm:sr-only">Copy</span><span class="sr-only"> command</span>
      </button>
    </div>
    <pre tabindex="0" class="mt-3 overflow-x-auto border border-track-strong bg-frame-raised px-4 py-3 font-mono text-sm leading-relaxed"><code data-copy-source>{code}</code></pre>
    <p data-copy-status role="status" aria-live="polite" class="mt-2 font-mono text-xs text-enamel-bright"></p>
    {extra && <div class="mt-10"><Fragment set:html={extra} /></div>}
  </div>
</li>

<script>
  import { bootCopyCommands } from "../scripts/copy-commands";
  bootCopyCommands();
</script>
