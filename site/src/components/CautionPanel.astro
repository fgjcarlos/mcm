---
interface Props {
  titleId: string;
  title: string;
  class?: string;
}

const { titleId, title, class: className } = Astro.props;
---

<section aria-labelledby={titleId} class:list={["border border-lamp/45 bg-lamp/[0.06]", className]}>
  <div aria-hidden="true" class="h-2 bg-[repeating-linear-gradient(-45deg,var(--color-lamp)_0_10px,transparent_10px_20px)]"></div>
  <div class="p-6 sm:p-10">
    <h2 id={titleId} class="max-w-3xl text-3xl font-bold uppercase leading-none text-enamel-bright sm:text-4xl">{title}</h2>
    <div class="mt-5 max-w-[68ch] leading-relaxed text-enamel-soft">
      <slot />
    </div>
  </div>
</section>
