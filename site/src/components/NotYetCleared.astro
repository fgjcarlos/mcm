---
interface Props {
  class?: string;
}

// Every limit, planned piece and deferred area is said once, here: one unlit lamp per row.
const { class: className } = Astro.props;
---

<article class={className}>
  <h3 class="text-2xl font-semibold uppercase tracking-[0.04em] text-enamel-bright">Not yet cleared</h3>
  <p class="mt-4 text-sm leading-relaxed text-enamel-muted">
    Planned: in MCM's agreed scope, not built yet. Limit: how MCM works by design. Deferred: waits until the one-broker journey is complete.
  </p>
  <ul class="mt-4 divide-y divide-track border-y border-track">
    <slot />
  </ul>
  {Astro.slots.has("note") && (
    <p class="mt-4 leading-relaxed text-enamel-soft"><slot name="note" /></p>
  )}
</article>
